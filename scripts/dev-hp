#!/bin/sh
# Development only: run the binary with the scratch root and a scrubbed
# environment, so it can never attach to the core session it was started from.
# Pass --session hp-dev on open, adopt-workspace and doctor.
#
# Every root has its own LaunchAgent label (`dev.hp.ticker.<hash of the
# canonical root>`, `ticker::agent_label`), so the ticker this root starts is
# separate from the real root's: neither can boot the other's out or rewrite its
# plist (before t-0083 both used `dev.hp.ticker`, and a dev run replaced the
# real one). Check both with `hp ticker status` under each root.
repo=$(cd "$(dirname "$0")/.." && pwd)
exec env -u HC_SESSION -u HC_TERMINAL_ID -u HC_BIN_PATH \
  HERDR_PROJECTS_ROOT="$repo/.dev-root" "$repo/target/release/hp" "$@"
